APP_NAME="Invox Pakistan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://invoxpakistan.test

# SEO & Domain Settings
SITE_NAME="Invox Pakistan"
SITE_URL="https://invox.pk"
TWITTER_HANDLE="@invoxpakistan"

# Search Console & Webmaster Verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Analytics & Tracking Integrations (Leave empty if not configured)
NEXT_PUBLIC_GA_ID=
GA_ID=
NEXT_PUBLIC_GTM_ID=
GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
LINKEDIN_PARTNER_ID=
CLARITY_ID=

# Google Ads Conversion Tracking
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invox_pakistan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@invox.pk"
MAIL_FROM_NAME="${APP_NAME}"
